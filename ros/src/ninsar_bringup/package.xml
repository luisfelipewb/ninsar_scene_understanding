<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ninsar_bringup</name>
  <version>0.0.0</version>
  <description>NINSAR system launch files, rviz configs and per-scenario node configs (config/isaac/, ...).</description>
  <maintainer email="luisfelipewb@gmail.com">Luis Felipe Wolf Batista</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- everything the launch files start -->
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>ninsar_perception</exec_depend>
  <exec_depend>ninsar_mapping</exec_depend>
  <exec_depend>voxeland</exec_depend>
  <exec_depend>hydra_visualizer</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
